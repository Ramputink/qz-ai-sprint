# generados en ejecución (no versionar)
# Anclados con "/" para que solo afecten a la raíz: sin la barra, "data/"
# también ignoraría src/data/, que es código y sí debe versionarse.
/data/
/checkpoints/
/artifacts/
# ...salvo los JSON de resultados: 56 KB en total, son la evidencia cruda de los
# barridos y lo que lee el panel de analyze/dashboard.py. Los .zip por etapa y los
# modelos exportados (18 MB) siguen fuera.
!/artifacts/
/artifacts/*
!/artifacts/*.json
/processview/
/logs/
state.json
.venv/
.venv-mac/
.venv-train-mac/
.venv-*/
__pycache__/
*.pyc
analyze/plots_out/
